#!/usr/bin/env python3
"""kelpinstall — the KelpOS installer (curses TUI, host side).

Walks the user through:
  1. picking the target device (Device of Choice),
  2. picking the packages to build into the kernel,
  3. writing the disk: partition table, FAT32 EFI/boot partition,
     bootloader (Limine) install, ISO contents copied to disk.

DRY-RUN BY DEFAULT: without --real nothing is written to the disk.
With --real it asks to confirm by typing the device path, then runs
sfdisk + mkfs.vfat + limine bios-install. Requires root for --real.

Usage:
  kelpinstall               # dry run, TUI
  kelpinstall --real /dev/sdX --packages ALL
"""
import argparse
import curses
import os
import shutil
import subprocess
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
# packages known to scripts/pkgconf.py
PKG_ALL = ["fs", "users", "fastfetch", "diskfs", "about", "mem", "crc",
           "cowsay", "fortune"]


def sh(cmd, dry, desc):
    """Run a host command; print it in dry-run mode instead."""
    print("  $", cmd)
    if not dry:
        r = subprocess.run(cmd, shell=True)
        if r.returncode != 0:
            raise SystemExit(f"kelpinstall: '{desc}' failed (rc={r.returncode})")


def list_devices():
    """Candidate block devices: fixed disks only (no loop/zram)."""
    out = []
    base = "/sys/block"
    if not os.path.isdir(base):
        return out
    for name in os.listdir(base):
        if name.startswith(("loop", "zram", "ram", "sr")):
            continue
        dev = "/dev/" + name
        if os.path.exists(dev):
            out.append(dev)
    return sorted(out)


def find_tool(*names):
    for n in names:
        p = shutil.which(n)
        if p:
            return n
    return names[0]


def install_plan(dev, pkgs, dry):
    sfdisk = find_tool("sfdisk")
    mkfs = find_tool("mkfs.vfat", "mkfs.fat")
    limine = os.path.join(REPO, "build/limine/limine")
    iso = os.path.join(REPO, "build/kelpos.iso")
    mnt = "/mnt/kelpos-install"

    print(f"\nKelpOS install plan for {dev}:")
    print(f"  packages: {', '.join(pkgs) if pkgs != ['ALL'] else 'ALL'}")
    steps = [
        (f"{sfdisk} --wipe=always {dev} <<EOF\nlabel: dos\n"
         f"start=63, type=0c, bootable\nEOF", "partitioning (FAT32, LBA 63)"),
        (f"{mkfs} -F 32 {dev}1", "mkfs.vfat on partition 1"),
        (f"mount {dev}1 {mnt}", "mounting"),
        (f"mkdir -p {mnt}/boot {mnt}/EFI/BOOT", "directory layout"),
        (f"cp -r build/limine/* {mnt}/boot/limine/", "Limine binaries"),
        (f"cp build/kelpos.iso {mnt}/", "kernel ISO payload"),
        (f"umount {mnt}", "unmounting"),
        (f"{limine} bios-install {dev}", "Limine BIOS install (MBR)"),
    ]
    for cmd, desc in steps:
        if dry:
            print(f"  [dry-run] {desc}: $ {cmd.splitlines()[0]} ...")
        else:
            sh(cmd, dry, desc)
    print("\nDone." if not dry else
          "\nDry run finished — nothing was written. Use --real to install.")


def tui(devices, dry):
    """curses UI: device of choice + package selection."""
    sel_pkg = {p: True for p in PKG_ALL}

    def menu(stdscr, title, items, default=0, checkbox=False):
        curses.curs_set(0)
        cur = default
        while True:
            stdscr.erase()
            h, w = stdscr.getmaxyx()
            stdscr.addstr(0, 2, title, curses.A_BOLD | curses.A_REVERSE)
            if checkbox:
                stdscr.addstr(1, 2, "[x] = install package, SPACE toggles")
            for i, it in enumerate(items):
                line = ("[x] " if sel_pkg.get(it) else "[ ] ") if checkbox \
                    else ("> " if i == cur else "  ")
                attr = curses.A_REVERSE if i == cur else curses.A_NORMAL
                stdscr.addstr(2 + i, 2, line + it, attr)
            stdscr.addstr(h - 1, 2, "UP/DOWN move  ENTER select  "
                                    "SPACE toggle  ESC quit", curses.A_DIM)
            k = stdscr.getch()
            if k in (curses.KEY_UP, ord('k')) and cur > 0:
                cur -= 1
            elif k in (curses.KEY_DOWN, ord('j')) and cur < len(items) - 1:
                cur += 1
            elif k == ord(' ') and checkbox:
                sel_pkg[items[cur]] = not sel_pkg[items[cur]]
            elif k in (10, curses.KEY_ENTER):
                return cur
            elif k == 27:
                return -1

    dev = None
    pkgs = list(PKG_ALL)

    def devmenu(stdscr):
        if not devices:
            stdscr.addstr(0, 0, "No block devices found!")
            stdscr.getch()
            return -1
        return menu(stdscr, "KelpOS Installer — Device of Choice "
                            f"(dry run: {dry})", devices)

    def pkgmenu(stdscr):
        r = menu(stdscr, "KelpOS Installer — Packages", PKG_ALL,
                 checkbox=True)
        if r < 0:
            return False
        return True

    def run(stdscr):
        nonlocal dev, pkgs
        r = devmenu(stdscr)
        if r < 0:
            return False
        dev = devices[r]
        if not pkgmenu(stdscr):
            return False
        pkgs = [p for p in PKG_ALL if sel_pkg[p]]
        return True

    ok = curses.wrapper(run)
    return (dev, pkgs) if ok else (None, None)


def main():
    ap = argparse.ArgumentParser(prog="kelpinstall",
                                 description="KelpOS installer (TUI)")
    ap.add_argument("--real", action="store_true",
                    help="actually write to the disk (default: dry run)")
    ap.add_argument("device", nargs="?", default=None,
                    help="target device (skips the device menu)")
    ap.add_argument("--packages", default=None,
                    help="comma-separated package list or 'ALL'")
    ap.add_argument("--non-interactive", action="store_true",
                    help="no TUI: needs device + --packages")
    args = ap.parse_args()

    dry = not args.real

    if args.non_interactive:
        if not args.device or not args.packages:
            ap.error("--non-interactive needs a device and --packages")
        dev = args.device
        pkgs = list(PKG_ALL) if args.packages.upper() == "ALL" \
            else args.packages.split(",")
    else:
        dev, pkgs = tui(list_devices(), dry)
        if not dev:
            print("kelpinstall: aborted.")
            return 1

    if not os.path.exists(dev):
        print(f"kelpinstall: no such device: {dev}")
        return 1

    if not dry:
        if os.geteuid() != 0:
            print("kelpinstall: --real needs root (sudo kelpinstall --real)")
            return 1
        print(f"\nWARNING: {dev} will be ERASED and KelpOS installed.")
        try:
            if input(f"Type the device name to confirm ({dev}): ").strip() != dev:
                print("kelpinstall: aborted.")
                return 1
        except (EOFError, KeyboardInterrupt):
            print("\nkelpinstall: aborted.")
            return 1

    install_plan(dev, pkgs, dry)
    return 0


if __name__ == "__main__":
    sys.exit(main())
